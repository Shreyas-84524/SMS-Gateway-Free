# Global OTP Platform — Environment Variables Example
# Duplicate this file to .env.local for local development.
# NEVER commit .env or .env.local files containing production credentials.

# Database Connection (PostgreSQL Connection String from Supabase or Neon)
DATABASE_URL=postgresql://user:password@host:port/database

# Optional direct pooled connection if using Supavisor or PgBouncer
# DIRECT_URL=postgresql://user:password@host:port/database

# Administrative Secret Key for managing projects & gateway credentials via CLI/Admin endpoints
ADMIN_SECRET_KEY=

# Default OTP Configuration (Optional overrides)
DEFAULT_OTP_EXPIRY_SECONDS=300
DEFAULT_OTP_COOLDOWN_SECONDS=30
DEFAULT_MAX_VERIFY_ATTEMPTS=3
DEFAULT_HOURLY_SEND_LIMIT=5

# Environment Mode (development / production / test)
NODE_ENV=development
